<%# Three different questions: what's on my plate, what I've asked of other
    people, and — for an admin — what everybody is dealing with. Someone who
    takes no tickets has only the middle one, so they get no switch. %>
<% if owner? %>
  <% options = [ [ "Yours", nil ], [ "You filed", "filed" ] ] %>
  <% options << [ "Everyone's", "everyone" ] if admin? %>

  <div class="flex items-center rounded-md border border-gray-200 bg-white text-sm overflow-hidden">
    <% options.each_with_index do |(label, scope), index| %>
      <% current = params[:scope].presence == scope %>
      <%= link_to label, path.call(scope),
            class: "px-3 py-1.5 #{'border-l border-gray-200' unless index.zero?} " \
                   "#{current ? 'bg-gray-100 font-medium text-gray-900' : 'text-gray-500 hover:text-gray-900'}" %>
    <% end %>
  </div>
<% end %>
