<%# One ticket, wherever a list of them appears: the dashboard queue, the
    tickets index, and the Turbo stream that puts a row back after its status
    changes. Admins get the requester and an inline status select; everyone
    else gets a badge, since they can't change it. %>
<div id="<%= dom_id(ticket, :row) %>" class="p-4 flex items-center gap-4">
  <% if admin? %>
    <%= avatar_tag(ticket.user, css_class: "size-9 rounded-full") %>
  <% end %>

  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      <%= link_to ticket.title, ticket_path(ticket), class: "font-medium text-gray-900 hover:underline" %>
      <span class="text-xs px-2 py-0.5 rounded-full <%= priority_badge_classes(ticket.priority) %>"><%= ticket.priority.humanize %></span>
      <% if admin? && ticket.user.priority_boost? %>
        <span class="text-xs px-2 py-0.5 rounded-full bg-purple-100 text-purple-700">VIP</span>
      <% end %>
      <%= render "tickets/badges", ticket: ticket %>
    </div>
    <p class="text-sm text-gray-500 truncate">
      <% if admin? %>
        <%= ticket.user.name.presence || ticket.user.email %> &middot;
      <% end %>
      <%= ticket.service.name %> &rsaquo; <%= ticket.topic.name %> &middot;
      <%= time_ago_in_words(ticket.created_at) %> ago
    </p>
  </div>

  <% if admin? %>
    <%= form_with model: ticket, url: ticket_path(ticket), method: :patch, class: "shrink-0" do |f| %>
      <%= f.select :status, Ticket.status_options, {}, class: "text-sm border border-gray-300 rounded-md px-2 py-1 bg-white shadow-sm focus:border-red-500 focus:ring-1 focus:ring-red-500 focus:outline-none", onchange: "this.form.requestSubmit()" %>
    <% end %>
  <% else %>
    <span class="shrink-0 text-xs px-2 py-0.5 rounded-full <%= status_badge_classes(ticket.status) %>"><%= ticket.status_label %></span>
  <% end %>
</div>
