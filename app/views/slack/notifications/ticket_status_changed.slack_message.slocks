# Rendered for the requester unless told otherwise.
recipient = local_assigns[:recipient] || ticket.user

section(
  "#{ticket.status_headline(recipient).sub(ticket.status_sentence, "*#{ticket.status_sentence}*")}\n" \
  "*<#{SlackNotifier.ticket_url(ticket)}|#{ticket.title}>*",
  markdown: true
)

section("> #{ticket.status_note.to_s.gsub("\n", "\n> ")}", markdown: true) if ticket.status_note.present?

context [
  mrkdwn_text(
    "#{ticket.service.name} ▸ #{ticket.topic.name}  ·  #{ticket.priority.humanize} priority" +
    (ticket.due_at.present? ? "  ·  ⏰ due #{ticket.due_on}" : "")
  )
]
