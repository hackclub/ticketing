title "New ticket"
submit "Create"
close "Cancel"
callback "create_ticket"

# Whoever owns the service is who the ticket goes to, so once more than one
# person is taking tickets the group labels have to say whose is whose.
many_owners = services.map(&:owner_id).uniq.size > 1

topic_groups = services.map do |service|
  label = many_owners ? "#{service.owner.display_name} · #{service.name}" : service.name

  option_group(
    label.truncate(75),
    service.topics.select(&:active?).map { |topic| option(topic.name, "#{service.id}:#{topic.id}") }
  )
end.reject { |group| group[:options].empty? }

priority_options = Ticket.priorities.keys.map { |priority| option(priority.humanize, priority) }

input "Title",
      plain_text_input("title", placeholder: "Short summary", max_length: 250),
      block_id: "title"

input "Service and topic",
      select_menu("topic", placeholder: "Pick one", option_groups: topic_groups),
      block_id: "topic"

input "Priority",
      select_menu("priority", placeholder: "Priority", options: priority_options,
                  initial_option: priority_options[Ticket.priorities[Ticket.new.priority]]),
      block_id: "priority"

input "Link",
      url_input("url", initial_value: initial_url.presence),
      block_id: "url",
      optional: true

input "Needed by",
      datetime_picker("due"),
      block_id: "due",
      optional: true,
      hint: "Leave it blank if there's no hard date."

input "Details",
      plain_text_input("message", multiline: true, initial_value: initial_message.to_s.truncate(2900).presence),
      block_id: "message",
      hint: "Markdown is supported."
