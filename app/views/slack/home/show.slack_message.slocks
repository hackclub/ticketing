# Emoji here, wording from Ticket, so a renamed status stays in step.
status_emoji = { "open" => "🟡", "in_progress" => "🔵", "done" => "🟢", "wont_do" => "⚪" }
status_label = ->(status) { "#{status_emoji[status]} #{Ticket.status_label(status)}".strip }
priority_labels = { "low" => "Low", "medium" => "Medium", "high" => "High", "urgent" => "🔴 Urgent" }

if user&.receives_tickets?
  header "Everything on your plate"
  section(
    tickets.any? ? "*#{tickets.size}* open and in-progress #{'ticket'.pluralize(tickets.size)}, VIP requesters and higher priority first." : "Nothing outstanding right now. 🎉",
    markdown: true
  )
else
  header "Your tickets"
  section(
    tickets.any? ? "Everything you've filed, newest first." : "You haven't filed anything yet.",
    markdown: true
  )
end

actions [
  button("New ticket", "open_new_ticket", style: "primary"),
  button("Open on the web", "open_web", url: SlackNotifier.url_for_path("/"))
]

if user&.receives_tickets?
  context [
    mrkdwn_text(
      "Manage <#{SlackNotifier.url_for_path('/services')}|your services and topics> on the web" +
      (user.admin? ? ", along with <#{SlackNotifier.url_for_path('/admin/users')}|people>." : ".")
    )
  ]
end

divider

tickets.each do |ticket|
  requester = ticket.user.slack_id.presence ? "<@#{ticket.user.slack_id}>" : "*#{ticket.user.name.presence || ticket.user.email}*"

  details = [
    (requester if user&.receives_tickets?),
    "#{ticket.service.name} ▸ #{ticket.topic.name}",
    priority_labels[ticket.priority],
    ("⏰ #{ticket.due_label}" if ticket.due_at.present?),
    ("🚧 blocked" if ticket.blocked?),
    "#{time_ago_in_words(ticket.created_at)} ago"
  ].compact.join("  ·  ")

  text = "*<#{SlackNotifier.ticket_url(ticket)}|#{ticket.title}>*\n#{details}"

  if user&.receives_tickets?
    status_options = Ticket.statuses.keys.map { |status| option(status_label.call(status), "#{ticket.id}:#{status}") }

    section(
      text,
      markdown: true,
      accessory: select_menu(
        "set_status",
        placeholder: "Status",
        options: status_options,
        initial_option: status_options[Ticket.statuses[ticket.status]]
      )
    )
  else
    section(
      "#{text}  ·  #{status_label.call(ticket.status)}",
      markdown: true,
      accessory: button("Reply", "comment_ticket", value: ticket.id.to_s)
    )
  end
end
