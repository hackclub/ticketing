<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Tickets" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tickets">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900"
        data-controller="command-palette"
        data-action="keydown@window->command-palette#hotkey">
    <nav class="bg-white border-b border-gray-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <%= link_to "Tickets", root_path, class: "font-bold text-lg text-red-600" %>
          <% if current_user %>
            <%= link_to "New ticket", new_ticket_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <%= link_to "All tickets", tickets_path(status: "all"), class: "text-sm text-gray-600 hover:text-gray-900" %>
            <% if admin? %>
              <div class="flex items-center gap-4 border-2 border-dashed border-orange-400 bg-orange-50 rounded-lg px-3 py-1">
                <%= link_to "Services & topics", admin_services_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
                <%= link_to "People", admin_users_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
              </div>
            <% end %>
          <% end %>
        </div>

        <% if current_user %>
          <div class="flex items-center gap-3">
            <%= link_to search_path, data: { action: "command-palette#open" },
                  class: "hidden sm:flex items-center gap-2 text-sm text-gray-400 hover:text-gray-600 border border-gray-200 rounded-md px-2 py-1 bg-white" do %>
              Search
              <kbd class="font-sans text-xs text-gray-400">⌘K</kbd>
            <% end %>
            <%= link_to "Settings", settings_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <%= avatar_tag(current_user, css_class: "size-8 rounded-full") %>
            <span class="text-sm text-gray-700"><%= current_user.name.presence || current_user.email %></span>
            <%= button_to "Sign out", "/logout", method: :delete, class: "text-sm text-gray-500 hover:text-gray-900 underline bg-transparent border-0 p-0 cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </nav>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
      <%= render "layouts/flash", notice: notice, alert: alert %>

      <%= yield %>
    </main>

    <%= render "layouts/command_palette" if current_user %>
    <%= render "layouts/footer" %>
  </body>
</html>
