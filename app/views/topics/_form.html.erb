<% if topic.errors.any? %>
  <div class="mb-4 rounded-md bg-red-50 text-red-800 px-4 py-3 text-sm">
    <ul class="list-disc list-inside">
      <% topic.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: topic, url: url, class: "space-y-4 max-w-sm" do |f| %>
  <div>
    <%= f.label :service_id, "Service", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :service_id, services.map { |s| [ s.name, s.id ] }, { prompt: "Select a service" }, class: input_classes, required: true %>
  </div>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: input_classes, required: true %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "rounded border-gray-300" %>
    <%= f.label :active, class: "text-sm text-gray-700" %>
  </div>

  <%= f.submit "Save", class: "bg-red-600 text-white px-4 py-2 rounded-md font-medium hover:bg-red-700 cursor-pointer" %>
<% end %>
